{
  "name": "famous",
  "version": "0.7.1",
  "description": "A powerful JavaScript rendering engine with 3D scene graph, DOM and WebGL rendering, physics, and animations",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "default": "./index.js"
    },
    "./core": "./core/index.js",
    "./core/*": "./core/*.js",
    "./components": "./components/index.js",
    "./components/*": "./components/*.js",
    "./physics": "./physics/index.js",
    "./physics/*": "./physics/*.js",
    "./math": "./math/index.js",
    "./math/*": "./math/*.js",
    "./transitions": "./transitions/index.js",
    "./transitions/*": "./transitions/*.js",
    "./utilities": "./utilities/index.js",
    "./utilities/*": "./utilities/*.js",
    "./renderers": "./renderers/index.js",
    "./renderers/*": "./renderers/*.js",
    "./dom-renderables": "./dom-renderables/index.js",
    "./dom-renderables/*": "./dom-renderables/*.js",
    "./dom-renderers": "./dom-renderers/index.js",
    "./dom-renderers/*": "./dom-renderers/*.js",
    "./webgl-renderables": "./webgl-renderables/index.js",
    "./webgl-renderables/*": "./webgl-renderables/*.js",
    "./webgl-renderers": "./webgl-renderers/index.js",
    "./webgl-renderers/*": "./webgl-renderers/*.js",
    "./webgl-geometries": "./webgl-geometries/index.js",
    "./webgl-geometries/*": "./webgl-geometries/*.js",
    "./webgl-materials": "./webgl-materials/index.js",
    "./webgl-materials/*": "./webgl-materials/*.js",
    "./webgl-shaders": "./webgl-shaders/index.js",
    "./webgl-shaders/*": "./webgl-shaders/*.js",
    "./render-loops": "./render-loops/index.js",
    "./render-loops/*": "./render-loops/*.js",
    "./polyfills": "./polyfills/index.js",
    "./polyfills/*": "./polyfills/*.js",
    "./errors": "./errors/index.js",
    "./errors/*": "./errors/*.js",
    "./builders": "./builders/index.js",
    "./builders/*": "./builders/*.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:min": "vite build --minify",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "types": "tsc --declaration --emitDeclarationOnly --outDir types",
    "prepare": "husky",
    "legacy:tape": "tap-closer | smokestack -b firefox | tap-spec",
    "legacy:test-new": "node ./scripts/test.js ./core/**/*.spec.js",
    "legacy:test-components": "browserify components/test/*.js | npm run legacy:tape",
    "legacy:test-core": "npm run legacy:test-new",
    "legacy:test-dom-renderables": "browserify dom-renderables/test/*.js | npm run legacy:tape",
    "legacy:test-dom-renderers": "browserify dom-renderers/test/*.js | npm run legacy:tape",
    "legacy:test-render-loops": "browserify render-loops/test/*.js | npm run legacy:tape",
    "legacy:test-math": "browserify math/test/*.js | npm run legacy:tape",
    "legacy:test-physics": "browserify physics/test/*.js physics/test/*/*.js | npm run legacy:tape",
    "legacy:test-polyfills": "browserify polyfills/test/*.js | npm run legacy:tape",
    "legacy:test-renderers": "browserify renderers/test/*.js | npm run legacy:tape",
    "legacy:test-transitions": "browserify transitions/test/*.js | npm run legacy:tape",
    "legacy:test-utilities": "browserify utilities/test/*.js | npm run legacy:tape",
    "legacy:test-webgl-geometries": "browserify webgl-geometries/test/*.js | npm run legacy:tape",
    "legacy:test-webgl-materials": "browserify webgl-materials/test/*.js | npm run legacy:tape",
    "legacy:test-webgl-renderables": "browserify webgl-renderables/test/*.js | npm run legacy:tape",
    "legacy:test-webgl-renderers": "browserify webgl-renderers/test/*.js | npm run legacy:tape",
    "legacy:test": "EXIT_STATUS=0; npm run legacy:test-components || EXIT_STATUS=$?; npm run legacy:test-core || EXIT_STATUS=$?; npm run legacy:test-dom-renderables || EXIT_STATUS=$?; npm run legacy:test-dom-renderers || EXIT_STATUS=$?; npm run legacy:test-render-loops || EXIT_STATUS=$?; npm run legacy:test-math || EXIT_STATUS=$?; npm run legacy:test-physics || EXIT_STATUS=$?; npm run legacy:test-polyfills || EXIT_STATUS=$?; npm run legacy:test-renderers || EXIT_STATUS=$?; npm run legacy:test-transitions || EXIT_STATUS=$?; npm run legacy:test-utilities || EXIT_STATUS=$?; npm run legacy:test-webgl-geometries || EXIT_STATUS=$?; npm run legacy:test-webgl-materials || EXIT_STATUS=$?; npm run legacy:test-webgl-renderables || EXIT_STATUS=$?; npm run legacy:test-webgl-renderers; exit $EXIT_STATUS",
    "legacy:check-jsdoc": "eslint --reset --no-eslintrc --rule 'valid-jsdoc: 2' --ignore-path .gitignore .",
    "legacy:lint": "eslint --ignore-path .gitignore .",
    "legacy:build": "npm run legacy:build-debug && npm run legacy:build-min",
    "legacy:build-debug": "browserify index.js -d --standalone famous > dist/famous.js",
    "legacy:build-min": "browserify index.js --standalone famous | uglifyjs --screw-ie8 -m -c dead_code,sequences,conditionals,booleans,unused,if_return,join_vars,drop_debugger > dist/famous.min.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Famous/engine.git"
  },
  "author": "Famous",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/ui": "^4.0.10",
    "browserify": "^10.2.1",
    "colors": "^1.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "glob": "^5.0.10",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "istanbul": "^0.3.15",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "rewire": "^2.3.3",
    "sinon": "^1.14.1",
    "smokestack": "^3.2.2",
    "tap-closer": "^1.0.0",
    "tap-spec": "^4.0.0",
    "tape": "^4.0.0",
    "typescript": "^5.9.3",
    "uglify-js": "^2.4.17",
    "vite": "^7.2.2",
    "vite-plugin-glsl": "^1.5.4",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "glslify": "^7.1.1"
  },
  "browserify": {
    "transform": [
      "glslify"
    ]
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
